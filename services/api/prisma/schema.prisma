generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "core", "timetracking"]
}

enum Role {
  OWNER
  MEMBER

  @@schema("auth")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  projects    Project[]
  timeEntries TimeEntry[]

  @@schema("auth")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())

  memberships Membership[]
  timeEntries TimeEntry[]

  @@schema("auth")
}

model Membership {
  id        String   @id @default(cuid())
  role      Role
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@schema("auth")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  contactInfo String?
  notes       String?
  createdAt   DateTime @default(now())

  organizationId String
  projects       Project[]

  @@schema("core")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED

  @@schema("core")
}

model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(ACTIVE)
  budget    Decimal?      @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  timeEntries TimeEntry[]

  @@schema("core")
}

model TimeEntry {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@schema("timetracking")
}
